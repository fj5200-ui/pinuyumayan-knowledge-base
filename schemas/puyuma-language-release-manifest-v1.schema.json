{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinuyumayan.tw/contracts/language-release-manifest-v1.schema.json",
  "title": "Pinuyumayan Language Release Manifest v1",
  "type": "object",
  "required": ["schema", "schema_version", "release_id", "release_version", "language_key", "generated_at", "files"],
  "properties": {
    "schema": {"const": "pinuyumayan.language-release-manifest"},
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 190},
    "release_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
    "language_key": {"const": "puyuma"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string"},
        "license_review_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "name", "url", "format", "compression", "records", "bytes", "sha256"],
        "properties": {
          "role": {"enum": ["corpus", "audio_manifest", "checksums", "schema"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 500},
          "url": {"type": "string", "minLength": 1, "maxLength": 2048},
          "format": {"enum": ["jsonl", "json"]},
          "compression": {"enum": ["gzip", "none"]},
          "records": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value_base64"],
      "properties": {
        "algorithm": {"const": "RSA-SHA256"},
        "key_id": {"type": "string"},
        "value_base64": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
