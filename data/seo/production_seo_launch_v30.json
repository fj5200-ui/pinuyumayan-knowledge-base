{
  "version": "v30",
  "name": "Production SEO launch policy",
  "required_before_publish": [
    "canonical_url",
    "title_length_20_to_65_zh_chars_or_equivalent",
    "description_length_60_to_160_chars",
    "og_title",
    "og_description",
    "og_image_1200x630",
    "article_schema_json_ld",
    "source_citation_block",
    "no_duplicate_claim_set",
    "forbidden_relation_check_passed"
  ],
  "sitemap_targets": [
    "/",
    "/communities",
    "/language/puyuma",
    "/articles",
    "/search"
  ],
  "cooldown_policy": {
    "same_topic_days": 10,
    "same_claim_set": "block",
    "similar_title_threshold": 0.92
  }
}
