{
  "version": "v10",
  "environments": {
    "local": {
      "database": "local MySQL or TiDB dev branch",
      "corpus_import": "optional",
      "api_keys": "may be bypassed for non-production"
    },
    "staging": {
      "database": "staging TiDB/MySQL",
      "corpus_import": "preview + sample full import",
      "api_keys": "required"
    },
    "production": {
      "database": "production TiDB/MySQL",
      "corpus_import": "post-deploy job only",
      "api_keys": "required with rotation"
    }
  },
  "required_env": [
    "DATABASE_URL",
    "PINUYUMAYAN_MAIN_SITE_API_KEY",
    "CORS_ORIGIN",
    "PUBLIC_KNOWLEDGE_BASE_URL"
  ],
  "optional_env": [
    "PUBLIC_RATE_LIMIT_PER_MINUTE",
    "INTERNAL_RATE_LIMIT_PER_MINUTE",
    "KNOWLEDGE_CACHE_DEFAULT_TTL_SECONDS",
    "PINUYUMAYAN_WEBHOOK_SIGNING_SECRET"
  ]
}
