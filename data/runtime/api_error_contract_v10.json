{
  "version": "v10",
  "shape": {
    "ok": false,
    "error": {
      "code": "STRING_CODE",
      "message": "Human-readable message",
      "details": {},
      "requestId": "req_xxx"
    }
  },
  "codes": [
    {
      "code": "BAD_REQUEST",
      "status": 400,
      "public": true
    },
    {
      "code": "UNAUTHORIZED",
      "status": 401,
      "public": true
    },
    {
      "code": "FORBIDDEN",
      "status": 403,
      "public": true
    },
    {
      "code": "NOT_FOUND",
      "status": 404,
      "public": true
    },
    {
      "code": "RATE_LIMITED",
      "status": 429,
      "public": true
    },
    {
      "code": "VALIDATION_ERROR",
      "status": 422,
      "public": true
    },
    {
      "code": "DB_UNAVAILABLE",
      "status": 503,
      "public": false
    },
    {
      "code": "JOB_LOCKED",
      "status": 409,
      "public": false
    },
    {
      "code": "INTERNAL_ERROR",
      "status": 500,
      "public": false
    }
  ],
  "logging_rules": [
    "Return requestId in every error.",
    "Do not expose SQL, filesystem paths, API keys, or internal stack traces.",
    "Store internal diagnostics in api_error_events when database is available."
  ]
}
