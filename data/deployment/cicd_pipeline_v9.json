{
  "version": "v9",
  "stages": [
    {
      "name": "lint_and_typecheck",
      "commands": [
        "cd backend && npm ci && npm run typecheck"
      ]
    },
    {
      "name": "python_validation",
      "commands": [
        "python3 -m py_compile scripts/*.py",
        "python3 scripts/validate_delivery_runtime_layer.py"
      ]
    },
    {
      "name": "contract_tests",
      "commands": [
        "python3 scripts/verify_main_site_contract.py --skip-network"
      ]
    },
    {
      "name": "migration_dry_run",
      "commands": [
        "./deploy/run-migrations.sh --dry-run"
      ]
    },
    {
      "name": "docker_build",
      "commands": [
        "docker build -t pinuyumayan-backend-database:ci backend"
      ]
    },
    {
      "name": "package_artifact",
      "commands": [
        "zip -r pinuyumayan-backend-database-v9.zip pinuyumayan-backend-database"
      ]
    }
  ],
  "release_gates": [
    "No rejected public content",
    "No blocked-license audio in public views",
    "Internal bundle rejects missing API key",
    "Full corpus import not coupled to API startup"
  ]
}
