{
  "version": "v30",
  "name": "Production secret rotation plan",
  "secrets": [
    {
      "name": "MAIN_SITE_API_KEY",
      "rotation": "90d or immediately on exposure",
      "browser_exposure_allowed": false
    },
    {
      "name": "PINUYUMAYAN_HMAC_SECRET",
      "rotation": "90d with overlap window",
      "browser_exposure_allowed": false
    },
    {
      "name": "ADMIN_SESSION_SECRET",
      "rotation": "180d; invalidate sessions if suspected leak",
      "browser_exposure_allowed": false
    },
    {
      "name": "OPENAI_API_KEY/KIMI_API_KEY",
      "rotation": "provider policy; never in client bundle",
      "browser_exposure_allowed": false
    },
    {
      "name": "DATABASE_URL",
      "rotation": "on staff change or incident",
      "browser_exposure_allowed": false
    }
  ],
  "overlap_strategy": "create secondary key, deploy, accept both for 24h, retire old key, verify failure for old key"
}
