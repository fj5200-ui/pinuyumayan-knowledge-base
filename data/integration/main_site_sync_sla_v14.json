{
  "version": "v14",
  "main_site_slo": {
    "bootstrap_p95_ms": 300,
    "search_p95_ms": 500,
    "vocabulary_page_p95_ms": 600,
    "delta_sync_p95_ms": 1000,
    "export_bundle_generation_p95_seconds": 30
  },
  "sync_strategy": [
    {
      "mode": "pull_delta",
      "recommended_interval_seconds": 300,
      "fallback": "bundle_export"
    },
    {
      "mode": "webhook_revalidate",
      "retry": "exponential_backoff",
      "dead_letter_after_attempts": 8
    },
    {
      "mode": "offline_export",
      "format": [
        "json",
        "jsonl"
      ],
      "trigger": "release_batch_published"
    }
  ],
  "main_site_cache_invalidation": [
    "release_promoted",
    "content_packet_updated",
    "vocabulary_import_verified",
    "quality_gate_failed",
    "manual_admin_request"
  ],
  "failure_policy": "If internal sync fails, public site continues serving last approved payload with stale warning in ops dashboard only."
}
