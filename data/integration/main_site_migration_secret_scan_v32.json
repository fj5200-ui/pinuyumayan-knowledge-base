{
  "version": "v32",
  "purpose": "Verify copied main-site routes/components do not leak server secrets into browser bundles.",
  "required_env": [
    "NEXT_PUBLIC_KB_API_URL",
    "PINUYUMAYAN_KB_API_URL",
    "PINUYUMAYAN_MAIN_SITE_CLIENT_ID",
    "PINUYUMAYAN_MAIN_SITE_API_KEY",
    "PINUYUMAYAN_HMAC_SECRET",
    "PINUYUMAYAN_HMAC_ENABLED",
    "AI_PROVIDER"
  ],
  "public_allowed_prefixes": [
    "NEXT_PUBLIC_"
  ],
  "server_only_secrets": [
    "PINUYUMAYAN_MAIN_SITE_API_KEY",
    "PINUYUMAYAN_HMAC_SECRET",
    "OPENAI_API_KEY",
    "KIMI_API_KEY",
    "ADMIN_SESSION_SECRET"
  ],
  "scan_targets": [
    "app/",
    "src/",
    "components/",
    "lib/",
    "pages/"
  ],
  "fail_patterns": [
    "OPENAI_API_KEY",
    "KIMI_API_KEY",
    "PINUYUMAYAN_HMAC_SECRET",
    "PINUYUMAYAN_MAIN_SITE_API_KEY"
  ],
  "allow_server_files": [
    "app/api/**",
    "src/server/**",
    "src/lib/server/**"
  ],
  "acceptance": [
    "No server-only secret in client component files",
    "AI provider call exists only in server route/server action",
    "HMAC request signing exists only in server route/server action",
    "NEXT_PUBLIC_KB_API_URL is the only public KB variable required by browser code"
  ]
}
