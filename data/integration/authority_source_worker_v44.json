      "name": "國家文化記憶庫",
      "query_hints": [
        "卑南族 歌謠",
        "卑南族 音樂",
        "南王 卑南族"
      ],
      "candidate_table": "authority_source_candidates_v44"
    },
    {
      "adapter_id": "golden_melody_awards",
      "name": "金曲獎",
      "query_hints": [
        "卑南族 音樂人",
        "原住民語專輯 卑南",
