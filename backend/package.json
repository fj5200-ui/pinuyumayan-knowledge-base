{
  "name": "pinuyumayan-backend-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "deploy:install": "cd .. && ./deploy/install.sh",
    "db:bootstrap:preview": "cd .. && python3 scripts/deploy_database.py --mode preview",
    "postdeploy:full-corpus": "cd .. && python3 scripts/deploy_full_corpus_import.py --download --min-entries ${FULL_CORPUS_MIN_ENTRIES:-1000}",
    "deploy:healthcheck": "cd .. && python3 scripts/healthcheck_main_site_api.py --base-url ${PUBLIC_KNOWLEDGE_BASE_URL:-http://localhost:8787}",
    "validate:deploy": "cd .. && python3 scripts/validate_deployment_install_layer.py",
    "deploy:preflight": "cd .. && ./deploy/preflight.sh",
    "deploy:migrations": "cd .. && ./deploy/run-migrations.sh",
    "deploy:backup": "cd .. && ./deploy/backup-db.sh --dry-run",
    "contract:main-site": "cd .. && python3 scripts/verify_main_site_contract.py --skip-network",
    "validate:production-ops": "cd .. && python3 scripts/validate_production_ops_layer.py",
    "validate:delivery-runtime": "cd .. && python3 scripts/validate_delivery_runtime_layer.py",
    "contract:openapi": "cd .. && python3 scripts/validate_openapi_contract.py",
    "worker:full-corpus": "tsx src/workers/fullCorpusImportWorker.ts",
    "worker:webhook-delivery": "tsx src/workers/webhookDeliveryWorker.ts",
    "ci:all": "npm run typecheck && cd .. && python3 scripts/validate_application_runtime_v10.py && python3 scripts/validate_delivery_runtime_layer.py && python3 scripts/validate_production_ops_layer.py && python3 scripts/verify_main_site_contract.py --skip-network && python3 scripts/validate_data_delivery_governance_v11.py",
    "validate:runtime-v10": "cd .. && python3 scripts/validate_application_runtime_v10.py",
    "ops:readiness": "curl -fsS ${PUBLIC_KNOWLEDGE_BASE_URL:-http://localhost:8787}/ready",
    "job:enqueue-full-corpus": "curl -fsS -X POST ${PUBLIC_KNOWLEDGE_BASE_URL:-http://localhost:8787}/api/internal/jobs/full-corpus/enqueue -H \"x-pinuyumayan-main-site-key: ${PINUYUMAYAN_MAIN_SITE_API_KEY}\" -H \"content-type: application/json\" -d \"{\\\"minEntries\\\":${FULL_CORPUS_MIN_ENTRIES:-1000}}\"",
    "validate:data-delivery-v11": "cd .. && python3 scripts/validate_data_delivery_governance_v11.py",
    "ops:api-version": "curl -fsS ${PUBLIC_KNOWLEDGE_BASE_URL:-http://localhost:8787}/api/public/version",
    "ops:enqueue-export": "curl -fsS -X POST ${PUBLIC_KNOWLEDGE_BASE_URL:-http://localhost:8787}/api/internal/exports/bundle/enqueue -H \"x-pinuyumayan-main-site-key: ${PINUYUMAYAN_MAIN_SITE_API_KEY}\" -H \"content-type: application/json\" -d \"{\"bundleType\":\"main_site_bootstrap\"}\"",
    "ops:replay-sync": "curl -fsS -X POST ${PUBLIC_KNOWLEDGE_BASE_URL:-http://localhost:8787}/api/internal/main-site/sync/replay -H \"x-pinuyumayan-main-site-key: ${PINUYUMAYAN_MAIN_SITE_API_KEY}\" -H \"content-type: application/json\" -d \"{\"since\":\"2026-06-01T00:00:00+08:00\"}\"",
    "validate:v12": "cd .. && python3 scripts/validate_governance_runtime_v12.py",
    "auth:bootstrap-superadmin": "cd .. && ./deploy/bootstrap-superadmin.sh",
    "content:build-seed": "cd .. && python3 scripts/build_content_seed_sql.py",
    "validate:v13": "cd .. && python3 scripts/validate_admin_auth_content_v13.py",
    "validate:v16-tts": "cd .. && python3 scripts/validate_pronunciation_tts_v16.py",
    "ci:all:v16": "npm run typecheck && cd .. && python3 scripts/validate_pronunciation_tts_v16.py && python3 scripts/validate_reliability_governance_v15.py && python3 scripts/validate_openapi_contract.py",
    "validate:v17-audio": "cd .. && python3 scripts/validate_pronunciation_audio_delivery_v17.py",
    "ci:all:v17": "npm run typecheck && cd .. && python3 scripts/validate_pronunciation_audio_delivery_v17.py && python3 scripts/validate_pronunciation_tts_v16.py && python3 scripts/validate_reliability_governance_v15.py && python3 scripts/validate_openapi_contract.py",
    "validate:ai-article:v18": "cd .. && python3 scripts/validate_ai_article_grounding_v18.py",
    "validate:v26": "cd .. && python3 scripts/validate_vps_db_core_v26.py",
    "db:vps:print-sql": "cd .. && ./deploy/vps-db-install-v26.sh --print-only",
    "db:vps:backup": "cd .. && ./deploy/vps-db-backup-v26.sh",
    "ci:all:v26": "npm run typecheck && cd .. && python3 scripts/validate_vps_db_core_v26.py && python3 scripts/validate_openapi_contract.py",
    "validate:v27": "cd .. && python3 scripts/validate_vps_staging_runtime_v27.py",
    "full-corpus:acceptance:v27": "cd .. && python3 scripts/build_vps_full_corpus_acceptance_v27.py --input data/web/puyuma_vocabulary_audio_entries.json --out data/database/full_corpus_acceptance_report_v27.generated.json",
    "ci:all:v27": "npm run typecheck && cd .. && python3 scripts/validate_vps_db_core_v26.py && python3 scripts/validate_vps_staging_runtime_v27.py && python3 scripts/validate_openapi_contract.py",
    "validate:v28": "cd .. && python3 scripts/validate_vps_live_ops_v28.py",
    "search:build:v28": "cd .. && python3 scripts/build_mysql_fulltext_index_v28.py"
  },
  "dependencies": {
    "@trpc/server": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "express": "latest",
    "mysql2": "latest",
    "superjson": "latest",
    "zod": "latest",
    "helmet": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
