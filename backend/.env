# ============================================================
# 卑南族文化知識庫 (KB) — 環境變數配置
# ============================================================
# ⚠️ 安全提醒: 此文件不應提交到 Git。請在生產環境中將敏感值設為實際密碼。

# ── Database ──
# 格式: mysql://user:password@host:port/database
# 注意: 密碼中的 # 必須 URL 編碼為 %23
DATABASE_URL=${KB_DATABASE_URL}

# ── Server ──
PORT=8787
NODE_ENV=production

# ── CORS ──
CORS_ORIGIN=http://localhost:3000,https://pinuyumayan.tw,https://www.pinuyumayan.tw

# ── Auth & Session ──
# 務必在生產環境中設置為高強度隨機字符串 (建議 48 字符以上)
PINUYUMAYAN_MAIN_SITE_API_KEY=${KB_API_KEY}
ADMIN_SESSION_SECRET=${KB_ADMIN_SESSION_SECRET}

# ── Admin ──
# 超級管理員密碼: 請在生產環境中設置強密碼
ADMIN_SUPERUSER_EMAIL=admin@pinuyumayan.tw
ADMIN_SUPERUSER_PASSWORD=${KB_ADMIN_PASSWORD}
ADMIN_SUPERUSER_DISPLAY_NAME=平台超級管理員

# ── URLs ──
PUBLIC_KNOWLEDGE_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000,https://pinuyumayan.tw,https://www.pinuyumayan.tw

# ── Webhook ──
WEBHOOK_SECRET=${KB_WEBHOOK_SECRET}

# ── Feature Flags ──
AUDIO_MIRROR_ENABLED=false
TTS_PUBLIC_UI_ENABLED=false
FULL_CORPUS_MIN_ENTRIES=1000
DEPLOY_INSTALL_MODE=preview
APPLY_DATABASE_BOOTSTRAP=true
MAIN_SITE_ADMIN_SYNC_ENABLED=false
AUDIO_PROXY_ENABLED=true
AUDIO_PROXY_ALLOWED_HOSTS=web.klokah.tw
PUBLIC_SYNTHETIC_TTS_ENABLED=false
PINUYUMAYAN_HMAC_ENFORCEMENT=observe
ARTICLE_TOPIC_COOLDOWN_DAYS=10
ARTICLE_REVIEW_REQUIRE_HUMAN_APPROVAL=true
