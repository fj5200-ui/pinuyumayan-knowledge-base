# Pinuyumayan Backend Database production environment
NODE_ENV=production
PORT=8787
DATABASE_URL=mysql://pinuyumayan_user:CHANGE_ME@127.0.0.1:4000/pinuyumayan

# Main site integration
PUBLIC_KNOWLEDGE_BASE_URL=https://kb-api.pinuyumayan.tw
PINUYUMAYAN_MAIN_SITE_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
CORS_ORIGIN=https://pinuyumayan.tw

# Rate limit / cache / sync
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_INTERNAL_PER_MINUTE=600
DEPLOY_LOCK_TTL_SECONDS=3600
FULL_CORPUS_MIN_ENTRIES=1000

# Audio mirroring - keep disabled until license review is complete
AUDIO_MIRROR_PROVIDER=none
AUDIO_MIRROR_BASE_URL=

# Backup
BACKUP_DIR=/var/backups/pinuyumayan-backend
BACKUP_RETENTION_DAYS=14


# Admin backend login and main-site superadmin sync
ADMIN_SUPERUSER_EMAIL=admin@example.invalid
ADMIN_SUPERUSER_DISPLAY_NAME=平台超級管理員
# Do not commit real password. Use secret manager / CI secret / SSH prompt.
ADMIN_SUPERUSER_PASSWORD=change-this-only-in-secret-manager
ADMIN_SESSION_SECRET=change-me-long-random-session-secret
MAIN_SITE_ADMIN_SYNC_ENABLED=false
MAIN_SITE_SUPERADMIN_EMAIL=admin@example.invalid
# v16 pronunciation-first TTS
PUYUMA_TTS_PUBLIC_SYNTHETIC_ENABLED=false
PUYUMA_TTS_DEFAULT_MODEL=puyuma_source_audio_passthrough_v1
PUYUMA_TTS_REQUIRE_HUMAN_REVIEW=true
PUYUMA_AUDIO_MIRROR_BASE_URL=

