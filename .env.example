# Pinuyumayan Backend Database Project
DATABASE_URL=mysql://user:password@localhost:3306/pinuyumayan
PORT=8787
NODE_ENV=development
AUDIO_MIRROR_ENABLED=false
TTS_PUBLIC_UI_ENABLED=false
FULL_CORPUS_MIN_ENTRIES=1000
PUYUMA_AUDIO_DRIVE_FOLDER_ID=1o_iEc2dbet-cENHLjv86R_b67M0TlakZ
# Main-site knowledge pull API
MAIN_SITE_API_KEY=change-me-main-site-shared-secret
PUBLIC_KNOWLEDGE_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000,https://pinuyumayan.tw,https://www.pinuyumayan.tw
WEBHOOK_SECRET=change-me-webhook-secret

# Deployment install behavior
DEPLOY_INSTALL_MODE=preview
APPLY_DATABASE_BOOTSTRAP=false
RUN_FULL_CORPUS_ON_DEPLOY=false
IMPORT_SQL_AFTER_BUILD=false
DEPLOY_REQUIRE_FULL_CORPUS=false


# Admin backend login and main-site superadmin sync
ADMIN_SUPERUSER_EMAIL=admin@example.invalid
ADMIN_SUPERUSER_DISPLAY_NAME=平台超級管理員
# Do not commit real password. Use secret manager / CI secret / SSH prompt.
ADMIN_SUPERUSER_PASSWORD=change-this-only-in-secret-manager
ADMIN_SESSION_SECRET=change-me-long-random-session-secret
MAIN_SITE_ADMIN_SYNC_ENABLED=false
MAIN_SITE_SUPERADMIN_EMAIL=admin@example.invalid
# v16 pronunciation-first TTS
PUYUMA_TTS_PUBLIC_SYNTHETIC_ENABLED=false
PUYUMA_TTS_DEFAULT_MODEL=puyuma_source_audio_passthrough_v1
PUYUMA_TTS_REQUIRE_HUMAN_REVIEW=true
PUYUMA_AUDIO_MIRROR_BASE_URL=


# v17 pronunciation audio delivery
AUDIO_PROXY_ENABLED=true
AUDIO_PROXY_ALLOWED_HOSTS=web.klokah.tw
PUBLIC_SYNTHETIC_TTS_ENABLED=false
